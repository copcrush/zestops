# =============================================================================
# ZestOps environment variables — TEMPLATE ONLY (no real secrets here).
#
# Local development: do NOT copy this by hand. Run
#     node scripts/setup-local-env.mjs
# which generates random local secrets into git-ignored files:
#     .env, apps/web/.env.local, services/payment-api/.env, services/monitoring-api/.env
#
# Production values are configured in the hosting dashboards (Vercel, Render,
# Neon). See docs/runbooks/DEPLOYMENT.md.
# =============================================================================

# ----- docker compose (.env at repository root) -----
POSTGRES_PORT=5432
POSTGRES_DB=zestops
POSTGRES_TEST_DB=zestops_test
POSTGRES_OWNER_USER=zestops_owner
POSTGRES_OWNER_PASSWORD=<generated>
ZESTOPS_WEB_DB_PASSWORD=<generated>
ZESTOPS_PAYMENT_DB_PASSWORD=<generated>
ZESTOPS_MONITORING_DB_PASSWORD=<generated>
PAYMENT_API_PORT=8080
MONITORING_API_PORT=8000
INTERNAL_JWT_ISSUER=zestops-web
# Base64 of the Ed25519 public key PEM (SPKI). Shared by both backends.
INTERNAL_JWT_PUBLIC_KEY_BASE64=<generated>

# ----- apps/web (.env.local) -----
# APP_ENV=development
# APP_ORIGIN=http://localhost:3000
# DATABASE_URL=postgres://zestops_web_app:<password>@localhost:5432/zestops
# PAYMENT_API_BASE_URL=http://localhost:8080
# MONITORING_API_BASE_URL=http://localhost:8000
# CSRF_SECRET=<32 random bytes, base64url>
# INTERNAL_JWT_KEY_ID=<key id>
# Base64 of the Ed25519 private key PEM (PKCS8). Web app ONLY — never give it to a backend.
# INTERNAL_JWT_PRIVATE_KEY_BASE64=<generated>
# SESSION_IDLE_TIMEOUT_MINUTES=30
# SESSION_ABSOLUTE_TIMEOUT_HOURS=8

# ----- services/payment-api (.env) -----
# APP_ENV=development
# PORT=8080
# DATABASE_URL=postgres://zestops_payment_app:<password>@localhost:5432/zestops?sslmode=disable
# INTERNAL_JWT_AUDIENCE=zestops-payment-api
# RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ----- services/monitoring-api (.env) -----
# APP_ENV=development
# PORT=8000
# DATABASE_URL=postgresql+asyncpg://zestops_monitoring_app:<password>@localhost:5432/zestops
# INTERNAL_JWT_AUDIENCE=zestops-monitoring-api
# MONITORING_ALLOWED_TARGETS=http://localhost:8080,http://localhost:8000
# MONITORING_ALLOW_PRIVATE_NETWORK_TARGETS=true   # local only; false in production
# DEMO_ENDPOINTS_ENABLED=true
